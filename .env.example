# Llave de la API de Anthropic (solo en el servidor; en Vercel: Settings > Environment Variables)
ANTHROPIC_API_KEY=
# Opcional: modelo del chat (por defecto claude-sonnet-5-5)
# POLIGT_MODEL=
# Opcional: otros dominios autorizados a llamar /api/chat (separados por coma). Tu propio dominio ya está permitido.
# ALLOWED_ORIGINS=https://mi-dominio.gt
# Opcional pero recomendado: límite de uso persistente (Upstash Redis / Vercel KV, API REST)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
