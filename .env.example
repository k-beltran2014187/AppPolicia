# Copia estos nombres en Vercel > Settings > Environment Variables (Production y Preview).
# Las dos primeras son públicas (van dentro de la app). La tercera es SECRETA: solo en Vercel, nunca en el código.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-SECRETA

# Opcional: correo que aparece en la política de privacidad
VITE_CONTACT_EMAIL=